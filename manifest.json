{
  "manifest_version": 3,
  "name": "Copy URL (Cmd+Shift+C)",
  "version": "1.0",
  "description": "Copy current tab URL to clipboard with Cmd+Shift+C",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-url": {
      "suggested_key": {
        "mac": "Command+Shift+C",
        "default": "Ctrl+Shift+C"
      },
      "description": "Copy current tab URL to clipboard"
    }
  }
}
